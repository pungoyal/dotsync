---
/**
 * dotsync's secret rules, read from the generated reference. The explanations are written here;
 * the build fails if the code gains a rule that isn't explained, or loses one that is.
 */
import { reference } from '../lib/reference';

interface Props {
	show: 'paths' | 'content';
}

const pathGroups: { covers: string; patterns: string[] }[] = [
	{ covers: 'SSH private keys', patterns: ['.ssh/id_*', '.ssh/*_key'] },
	{ covers: 'TLS and signing keys, keystores', patterns: ['*.pem', '*.key', '*.p12', '*.pfx', '*.jks', '*.keystore'] },
	{ covers: 'Password databases', patterns: ['*.kdbx', '.password-store/*'] },
	{
		covers: 'GnuPG private keys (gpg.conf and gpg-agent.conf are fine)',
		patterns: ['.gnupg/private-keys-v1.d/*', '.gnupg/secring.*', '.gnupg/*.key'],
	},
	{ covers: 'Desktop keyrings', patterns: ['.local/share/keyrings/*'] },
	{
		covers: 'age private keys used by mise and sops',
		patterns: ['.config/mise/age.txt', '.config/sops/age/*', 'library/application support/sops/age/*'],
	},
	{
		covers: 'Cloud credentials',
		patterns: ['.aws/credentials', '.aws/sso/*', '.azure/*', '.config/gcloud/*', '.kube/config'],
	},
	{
		covers: 'Tool credentials',
		patterns: ['.docker/config.json', '.netrc', '.git-credentials', '.pgpass', '.vault-token', '.config/gh/hosts.yml'],
	},
	{ covers: 'Environment files', patterns: ['.env', '.env.*', '*.env'] },
	{ covers: 'Anything named like a secret', patterns: ['*secret*', '*credential*'] },
	{ covers: 'Shell and REPL histories', patterns: ['.*history'] },
];

const contentRules: Record<string, string> = {
	'private key': 'Private key blocks of any kind: RSA, EC, OpenSSH, encrypted PKCS #8, PGP…',
	'private age key': 'age private keys (AGE-SECRET-KEY-1…)',
	'AWS access key': 'AWS access key IDs (AKIA…, ASIA…)',
	'GitHub token': 'GitHub tokens (ghp_, gho_, ghu_, ghs_, ghr_, github_pat_)',
	'GitLab token': 'GitLab personal access tokens (glpat-)',
	'Slack token': 'Slack tokens (xoxa-, xoxb-, xoxo-, xoxp-, xoxr-, xoxs-)',
	'API key': 'sk- style API keys, including sk-ant- and sk-proj-',
	'Google API key': 'Google API keys (AIza…)',
	'npm token': 'npm auth tokens in .npmrc (_authToken=…)',
	'password in a URL': 'A password in a URL: scheme://user:password@host',
	'password or token assignment':
		'password, passwd, secret, token, api_key, access_key or client_secret, then = or :, then a literal value of 8 or more characters',
};

// Keep the explanations and the code in step.
const grouped = pathGroups.flatMap((g) => g.patterns);
const missingPaths = reference.secrets.paths.filter((p) => !grouped.includes(p));
const stalePaths = grouped.filter((p) => !reference.secrets.paths.includes(p));
const ruleNames = reference.secrets.content.map((r) => r.name);
const missingRules = ruleNames.filter((n) => !(n in contentRules));
const staleRules = Object.keys(contentRules).filter((n) => !ruleNames.includes(n));
if (missingPaths.length || stalePaths.length || missingRules.length || staleRules.length) {
	throw new Error(
		'SecretRules.astro is out of step with internal/dotsync/secrets.go: ' +
			JSON.stringify({ missingPaths, stalePaths, missingRules, staleRules })
	);
}

// Paths are matched case-insensitively and stored lower-case; show the macOS directory as it's spelled.
const display = (p: string) => p.replace('library/application support', 'Library/Application Support');
const { show } = Astro.props;
---

{
	show === 'paths' ? (
		<table>
			<thead>
				<tr>
					<th scope="col">Patterns</th>
					<th scope="col">Covers</th>
				</tr>
			</thead>
			<tbody>
				{pathGroups.map((g) => (
					<tr>
						<td class="patterns">
							{g.patterns.map((p, i) => (
								<>
									{i > 0 && ' '}
									<code>{display(p)}</code>
								</>
							))}
						</td>
						<td>{g.covers}</td>
					</tr>
				))}
			</tbody>
		</table>
	) : (
		<table>
			<thead>
				<tr>
					<th scope="col">Detects</th>
					<th scope="col">Regular expression</th>
				</tr>
			</thead>
			<tbody>
				{reference.secrets.content.map((r) => (
					<tr>
						<td>{contentRules[r.name]}</td>
						<td class="rx">
							<code>{r.pattern}</code>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	)
}

<style>
	.patterns {
		line-height: 2;
	}
	.patterns code {
		white-space: nowrap;
	}
	.rx code {
		font-size: 0.78rem;
		white-space: normal;
		overflow-wrap: anywhere;
		word-break: break-all;
	}
</style>
