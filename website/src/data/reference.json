{
  "//": "Generated by internal/dotsync/reference_test.go. Do not edit; run: go test ./internal/dotsync -run TestWebsiteReference -update-reference",
  "commands": [
    {
      "title": "setup",
      "commands": [
        {
          "name": "init",
          "args": "<git-url>",
          "usage": "dotsync init [options] <git-url>",
          "summary": "set up this machine: clone, first sync, install the background agent",
          "flags": [
            {
              "names": [
                "--branch"
              ],
              "value": "branch",
              "usage": "the branch to sync (default main)"
            },
            {
              "names": [
                "--interval"
              ],
              "value": "seconds",
              "usage": "seconds between automatic syncs (default 300)"
            },
            {
              "names": [
                "--keep-existing"
              ],
              "usage": "report existing differing local files as conflicts instead of replacing them (after a backup)"
            },
            {
              "names": [
                "--no-agent"
              ],
              "usage": "do not install the background agent"
            },
            {
              "names": [
                "--no-install"
              ],
              "usage": "do not copy dotsync to ~/.local/bin"
            }
          ]
        },
        {
          "name": "doctor",
          "usage": "dotsync doctor",
          "summary": "check the setup and explain how to fix problems",
          "flags": []
        },
        {
          "name": "update",
          "usage": "dotsync update [--check] [--version vX.Y.Z] [--require-attestation]",
          "summary": "install the latest release (verified)",
          "flags": [
            {
              "names": [
                "--check"
              ],
              "usage": "only report whether an update is available"
            },
            {
              "names": [
                "--require-attestation"
              ],
              "usage": "fail unless the build provenance can be verified with the GitHub CLI"
            },
            {
              "names": [
                "--version"
              ],
              "value": "vX.Y.Z",
              "usage": "install release vX.Y.Z instead of the latest (also allows downgrades)"
            }
          ]
        },
        {
          "name": "agent",
          "args": "install|uninstall|status",
          "usage": "dotsync agent install|uninstall|status",
          "summary": "manage the background agent",
          "flags": []
        },
        {
          "name": "import",
          "args": "stow <dir> [package...]",
          "usage": "dotsync import stow [options] <stow-dir> [package...]",
          "summary": "move from GNU Stow: replace its symlinks with real files and manage them",
          "flags": [
            {
              "names": [
                "--allow-secrets"
              ],
              "usage": "also import files that look like secrets (only those entries are marked allow_secrets)"
            },
            {
              "names": [
                "--apply"
              ],
              "usage": "replace the links with real files and manage them (default: only show the plan)"
            },
            {
              "names": [
                "--no-sync"
              ],
              "usage": "only queue the change; the next sync pushes it"
            }
          ]
        }
      ]
    },
    {
      "title": "managing files (changes apply to every machine)",
      "commands": [
        {
          "name": "add",
          "args": "<path>...",
          "usage": "dotsync add [options] <path>...",
          "summary": "start managing files or directories",
          "flags": [
            {
              "names": [
                "--allow-secrets"
              ],
              "usage": "allow content that looks like credentials"
            },
            {
              "names": [
                "-d",
                "--description"
              ],
              "value": "text",
              "usage": "describe the entry with text (default: the file name)"
            },
            {
              "names": [
                "--ignore"
              ],
              "value": "glob",
              "repeats": true,
              "usage": "for directories: a glob of names or paths not to sync (repeatable)"
            },
            {
              "names": [
                "--no-sync"
              ],
              "usage": "only queue the change; the next sync pushes it"
            },
            {
              "names": [
                "--os"
              ],
              "value": "OS",
              "repeats": true,
              "usage": "only manage the entry on this OS: darwin or linux (repeatable)"
            },
            {
              "names": [
                "--source"
              ],
              "value": "path",
              "usage": "path of the content under the repository's files/ (default: derived from the path)"
            }
          ]
        },
        {
          "name": "remove",
          "aliases": [
            "rm"
          ],
          "args": "<path|source>...",
          "usage": "dotsync remove [-no-sync] <path|source>...",
          "summary": "stop managing (local copies are kept on every machine)",
          "flags": [
            {
              "names": [
                "--no-sync"
              ],
              "usage": "only queue the change"
            }
          ]
        },
        {
          "name": "set",
          "args": "<path|source> ...",
          "usage": "dotsync set <path|source> [changes]",
          "summary": "change an entry: --ignore, --os, --mode, --write, -d, …",
          "flags": [
            {
              "names": [
                "--allow-secrets"
              ],
              "usage": "allow content that looks like credentials (use --allow-secrets=false to undo)"
            },
            {
              "names": [
                "--any-os"
              ],
              "usage": "manage on every OS (removes the os restriction)"
            },
            {
              "names": [
                "--clear-ignore"
              ],
              "usage": "remove every ignore pattern"
            },
            {
              "names": [
                "-d",
                "--description"
              ],
              "value": "text",
              "usage": "describe the entry with text"
            },
            {
              "names": [
                "--ignore"
              ],
              "value": "glob",
              "repeats": true,
              "usage": "add an ignore glob (repeatable)"
            },
            {
              "names": [
                "--mode"
              ],
              "value": "mode",
              "usage": "force these octal permissions (mode, e.g. 0600) on every machine"
            },
            {
              "names": [
                "--no-mode"
              ],
              "usage": "stop forcing permissions"
            },
            {
              "names": [
                "--no-sync"
              ],
              "usage": "only queue the change"
            },
            {
              "names": [
                "--os"
              ],
              "value": "OS",
              "repeats": true,
              "usage": "only manage the entry on this OS: darwin or linux (repeatable; replaces the current list)"
            },
            {
              "names": [
                "--unignore"
              ],
              "value": "glob",
              "repeats": true,
              "usage": "remove an ignore glob (repeatable)"
            },
            {
              "names": [
                "--write"
              ],
              "value": "atomic|inplace",
              "usage": "how local files are replaced (atomic|inplace)"
            }
          ]
        },
        {
          "name": "describe",
          "args": "<path|source> <text>",
          "usage": "dotsync describe <path|source> <description>",
          "summary": "change an entry's description",
          "flags": []
        }
      ]
    },
    {
      "title": "this machine only",
      "commands": [
        {
          "name": "exclude",
          "args": "<path|source>",
          "usage": "dotsync exclude [--no-sync] <path|source>...",
          "summary": "stop managing an entry here (files are left as they are)",
          "flags": [
            {
              "names": [
                "--no-sync"
              ],
              "usage": "don't sync afterwards"
            }
          ]
        },
        {
          "name": "include",
          "args": "<path|source>",
          "usage": "dotsync include [--no-sync] <path|source>...",
          "summary": "manage an excluded entry here again",
          "flags": [
            {
              "names": [
                "--no-sync"
              ],
              "usage": "don't sync afterwards"
            }
          ]
        }
      ]
    },
    {
      "title": "everyday",
      "commands": [
        {
          "name": "status",
          "aliases": [
            "st"
          ],
          "usage": "dotsync status [-fetch] [-v] [-json]",
          "summary": "managed files and their state on this machine",
          "flags": [
            {
              "names": [
                "--fetch"
              ],
              "usage": "fetch from the remote first"
            },
            {
              "names": [
                "--json"
              ],
              "usage": "machine-readable output"
            },
            {
              "names": [
                "-v"
              ],
              "usage": "list every file"
            }
          ]
        },
        {
          "name": "list",
          "aliases": [
            "ls"
          ],
          "usage": "dotsync list [-json]",
          "summary": "the shared manifest",
          "flags": [
            {
              "names": [
                "--json"
              ],
              "usage": "machine-readable output"
            }
          ]
        },
        {
          "name": "sync",
          "usage": "dotsync sync [-q]",
          "summary": "synchronize now (the agent does this periodically)",
          "flags": [
            {
              "names": [
                "-q",
                "--quiet"
              ],
              "usage": "no output; exit silently if a sync is already running (used by the agent)"
            }
          ]
        },
        {
          "name": "diff",
          "args": "[path...]",
          "usage": "dotsync diff [-fetch] [path...]",
          "summary": "differences between this machine and the remote",
          "flags": [
            {
              "names": [
                "--fetch"
              ],
              "usage": "fetch from the remote first"
            }
          ]
        },
        {
          "name": "resolve",
          "args": "<path>... --keep local|remote",
          "usage": "dotsync resolve <path>... --keep local|remote",
          "summary": "settle a conflict",
          "flags": [
            {
              "names": [
                "--keep"
              ],
              "value": "local|remote",
              "usage": "which version wins (local|remote): this machine's, or the repository's"
            }
          ]
        },
        {
          "name": "log",
          "usage": "dotsync log [-n N]",
          "summary": "recent changes to the shared repository",
          "flags": [
            {
              "names": [
                "-n"
              ],
              "value": "N",
              "default": "20",
              "usage": "show the last N commits"
            }
          ]
        }
      ]
    }
  ],
  "secrets": {
    "paths": [
      ".ssh/id_*",
      ".ssh/*_key",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "*.jks",
      "*.keystore",
      "*.kdbx",
      ".gnupg/private-keys-v1.d/*",
      ".gnupg/secring.*",
      ".gnupg/*.key",
      ".password-store/*",
      ".aws/credentials",
      ".aws/sso/*",
      ".azure/*",
      ".config/gcloud/*",
      ".kube/config",
      ".docker/config.json",
      ".netrc",
      ".git-credentials",
      ".pgpass",
      ".vault-token",
      ".config/gh/hosts.yml",
      ".local/share/keyrings/*",
      ".env",
      ".env.*",
      "*.env",
      "*secret*",
      "*credential*",
      ".*history",
      ".config/mise/age.txt",
      ".config/sops/age/*",
      "library/application support/sops/age/*"
    ],
    "content": [
      {
        "name": "private key",
        "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----"
      },
      {
        "name": "private age key",
        "pattern": "AGE-SECRET-KEY-1[02-9AC-HJ-NP-Z]{58}"
      },
      {
        "name": "AWS access key",
        "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
      },
      {
        "name": "GitHub token",
        "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})"
      },
      {
        "name": "GitLab token",
        "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}"
      },
      {
        "name": "Slack token",
        "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"
      },
      {
        "name": "API key",
        "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}"
      },
      {
        "name": "Google API key",
        "pattern": "\\bAIza[0-9A-Za-z_-]{35}"
      },
      {
        "name": "npm token",
        "pattern": "_authToken\\s*=\\s*[^\\s$]{8,}"
      },
      {
        "name": "password in a URL",
        "pattern": "\\b[A-Za-z][A-Za-z0-9+.-]*://[^\\s/:@]*:[^\\s/@$({<%][^\\s/@]*@"
      },
      {
        "name": "password or token assignment",
        "pattern": "(?i)(?:password|passwd|secret|token|api[_-]?key|access[_-]?key|client[_-]?secret)[\"']?\\s*[:=]\\s*[\"']?[^\\s\"'$(){}<>]{8,}"
      }
    ],
    "allow_marker": "dotsync:allow-secret"
  },
  "default_ignore": [
    ".DS_Store",
    "._*",
    "*.swp",
    "*.swo",
    "*~",
    ".#*",
    ".git",
    "__pycache__",
    "*.pyc",
    ".dotsync-tmp-*"
  ],
  "supported_os": [
    "darwin",
    "linux"
  ],
  "git_settings": [
    [
      "user.name",
      "dotsync (<host>)"
    ],
    [
      "user.email",
      "dotsync@<host>"
    ],
    [
      "commit.gpgsign",
      "false"
    ],
    [
      "core.autocrlf",
      "false"
    ],
    [
      "core.filemode",
      "true"
    ],
    [
      "core.symlinks",
      "true"
    ],
    [
      "core.hooksPath",
      "/dev/null"
    ],
    [
      "gc.auto",
      "0"
    ],
    [
      "maintenance.auto",
      "false"
    ],
    [
      "core.logAllRefUpdates",
      "false"
    ]
  ],
  "defaults": {
    "interval": 300,
    "backup_retention_days": 90,
    "max_file_size_mib": 10,
    "push_attempts": 5,
    "agent_label": "io.github.dotsync",
    "cron_tag": "# dotsync-agent"
  }
}
